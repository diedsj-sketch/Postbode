FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt && useradd --uid 10001 --create-home mailroom
COPY mailroom.py serve.py ./
RUN mkdir /data && chown mailroom:mailroom /data
ENV DATA_DIR=/data
ENV PROCESSING_ENABLED=false
ENV ENABLE_EMAIL=false
ENV ENABLE_CALENDAR=false
ENV PYTHONUNBUFFERED=1
EXPOSE 8080
# serve.py initializes the mounted volume and drops to UID 10001 before starting services.
CMD ["python", "serve.py"]
