# No secrets included. Supply through your host's secret manager.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
POSTBODE_WEBHOOK_SECRET=
# Required recipient UUID from Postbode. Only v2 payloads are accepted.
POSTBODE_RECIPIENT_UUID=
DATA_DIR=./data
# Created by authorize_google.py, outside source control.
GOOGLE_TOKEN_FILE=./token.json
GOOGLE_DRIVE_FOLDER_ID=
ALERT_EMAIL=
# Disabled until a personal calendar has been selected and authorized.
GOOGLE_CALENDAR_ID=
ENABLE_CALENDAR=false
ENABLE_EMAIL=false

# Keep the Railway worker stopped during setup.
PROCESSING_ENABLED=false
